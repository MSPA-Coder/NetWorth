# Arquivo de ambiente do VPS. Copie para .env.vps; nao inclua segredos aqui.
POSTGRES_DB=networth
POSTGRES_USER=networth
POSTGRES_PORT=5702
APP_PORT=5701
DEBUG=False
USE_HTTPS=True
# 127.0.0.1 e o Host do healthcheck do conteiner.
ALLOWED_HOSTS=networth-mspa.duckdns.org,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://networth-mspa.duckdns.org

# As fontes pelo endereco PUBLICO. No loopback do VPS as duas respondem 301 a
# tudo (redirecionamento para HTTPS), e a porta publicada em 127.0.0.1 nao e
# alcancavel de dentro de outro conteiner.
FONTE_CB_URL=https://bancario-mspa.duckdns.org
FONTE_CRV_URL=https://renda-mspa.duckdns.org
