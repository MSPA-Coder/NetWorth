# Copie para .env.docker. As portas sao publicadas somente em 127.0.0.1.
POSTGRES_DB=networth
POSTGRES_USER=networth
POSTGRES_PORT=5702
APP_PORT=5701

# Enderecos das fontes. Sem endereco OU sem token, a fonte nao e consultada e a
# tela avisa que ela esta configurada pela metade -- erro de implantacao tem de
# ser visivel.
#
# Local, com os tres aplicativos na mesma maquina: o contêiner alcanca o host
# por `host.docker.internal` (o compose.yaml ja mapeia esse nome).
FONTE_CB_URL=http://host.docker.internal:5201
FONTE_CRV_URL=http://host.docker.internal:5301

# Os tokens NAO ficam aqui: sao arquivos em .secrets/, um por fonte, com o
# valor que cada sistema publicador concedeu.
#   .secrets/django_secret_key
#   .secrets/postgres_password
#   .secrets/fonte_cb_token
#   .secrets/fonte_crv_token
#
# Os quatro arquivos precisam EXISTIR para o Compose subir -- ele recusa um
# segredo declarado e ausente. Um arquivo de token VAZIO quer dizer "esta fonte
# ainda nao me concedeu acesso": a fonte fica como configurada pela metade e a
# tela avisa, em vez de sumir em silencio. E o caso do Renda Variavel enquanto
# a rota dele nao existir.

# Opcional. O padrao e False; ligue apenas em maquina de desenvolvimento.
# DEBUG=False
